generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int            @id @default(autoincrement())
  name      String
  email     String         @unique
  password  String
  role      Role           @default(member)
  token     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  projects  Project[]
  progress  UserProgress[]
  notifications Notification[]
  certificates Certificate[]
  passwordResetOtps PasswordResetOtp[]

  @@index([role])
}

model Course {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  modules     Module[]
  projects    Project[]
  certificates Certificate[]
  projectRequirements ProjectRequirement[]

  @@index([title])
}

model Module {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  order       Int
  courseId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isDeleted   Boolean   @default(false)
  lessons     Lesson[]
  projects    Project[]

  @@index([courseId])
}

model Lesson {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  content       String?
  type          LessonType     @default(MATERIAL)
  order         Int
  kkm           Int            @default(70)
  moduleId      Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contentBlocks ContentBlock[]
  quizzes       Quiz[]
  progress      UserProgress[]
  projects      Project[]

  @@index([moduleId])
}

model ContentBlock {
  id        Int              @id @default(autoincrement())
  type      ContentBlockType @default(TEXT)
  order     Int
  title     String?
  content   Json
  lessonId  Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isDeleted Boolean          @default(false)

  @@index([lessonId])
}

model Quiz {
  id            Int      @id @default(autoincrement())
  question      String
  options       Json
  correctAnswer String
  lessonId      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isDeleted     Boolean  @default(false)

  @@index([lessonId])
}

model UserProgress {
  id        Int            @id @default(autoincrement())
  status    ProgressStatus @default(LOCKED)
  score     Float?
  answers   Json?
  userId    Int
  lessonId  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
}

model Project {
  id         Int           @id @default(autoincrement())
  linkGithub String
  note       String?
  status     ProjectStatus @default(pending)
  userId     Int
  courseId   Int
  moduleId   Int?
  lessonId   Int?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  course     Course        @relation(fields: [courseId], references: [id])
  module     Module?       @relation(fields: [moduleId], references: [id])
  lesson     Lesson?       @relation(fields: [lessonId], references: [id])
  user       User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model ProjectRequirement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  order       Int      @default(1)
  courseId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([isDeleted])
}

model PasswordResetOtp {
  id         Int       @id @default(autoincrement())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  userId     Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?
  isRead    Boolean          @default(false)
  userId    Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model CertificateTemplate {
  id           Int           @id @default(autoincrement())
  name         String
  backgroundPath String
  backgroundUrl  String
  imageWidth   Int
  imageHeight  Int
  nameX        Int           @default(420)
  nameY        Int           @default(320)
  dateX        Int           @default(420)
  dateY        Int           @default(470)
  qrX          Int           @default(940)
  qrY          Int           @default(470)
  qrSize       Int           @default(120)
  fontFamily   String        @default("Helvetica")
  nameFontSize Int           @default(42)
  dateFontSize Int           @default(18)
  textColor    String        @default("#1A2E20")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  certificates Certificate[]
}

model Certificate {
  id              Int                 @id @default(autoincrement())
  code            String              @unique
  userName        String
  learningPath    String
  issuedAt        DateTime            @default(now())
  pdfPath         String
  pdfUrl          String
  verificationUrl String
  userId          Int
  courseId        Int
  templateId      Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  template        CertificateTemplate @relation(fields: [templateId], references: [id])

  @@unique([userId, courseId])
  @@index([code])
  @@index([userId])
  @@index([courseId])
}

enum Role {
  admin
  mentor
  member
}

enum ProgressStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
  FAILED    
}

enum ProjectStatus {
  pending
  approved
  rejected
}

enum LessonType {
  MATERIAL
  QUIZ
}

enum ContentBlockType {
  TEXT
  VIDEO
  IMAGE
  CODE
  CALLOUT
  RESOURCE
}

enum NotificationType {
  INFO
  MODULE_CREATED
  MODULE_COMPLETED
}
