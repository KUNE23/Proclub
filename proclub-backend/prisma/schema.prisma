generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int            @id @default(autoincrement())
  name      String
  email     String         @unique
  password  String
  role      Role           @default(member)
  token     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  projects  Project[]
  progress  UserProgress[]

  @@index([role])
}

model Course {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  modules     Module[]
  projects    Project[]

  @@index([title])
}

model Module {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  order       Int
  courseId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isDeleted   Boolean   @default(false)
  lessons     Lesson[]
  projects    Project[]

  @@index([courseId])
}

model Lesson {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  content       String?
  type          LessonType     @default(MATERIAL)
  order         Int
  kkm           Int            @default(70)
  moduleId      Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contentBlocks ContentBlock[]
  quizzes       Quiz[]
  progress      UserProgress[]
  projects      Project[]

  @@index([moduleId])
}

model ContentBlock {
  id        Int              @id @default(autoincrement())
  type      ContentBlockType @default(TEXT)
  order     Int
  title     String?
  content   Json
  lessonId  Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isDeleted Boolean          @default(false)

  @@index([lessonId])
}

model Quiz {
  id            Int      @id @default(autoincrement())
  question      String
  options       Json
  correctAnswer String
  lessonId      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isDeleted     Boolean  @default(false)

  @@index([lessonId])
}

model UserProgress {
  id        Int            @id @default(autoincrement())
  status    ProgressStatus @default(LOCKED)
  score     Float?
  answers   Json?
  userId    Int
  lessonId  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
}

model Project {
  id         Int           @id @default(autoincrement())
  linkGithub String
  note       String?
  status     ProjectStatus @default(pending)
  userId     Int
  courseId   Int
  moduleId   Int?
  lessonId   Int?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  course     Course        @relation(fields: [courseId], references: [id])
  module     Module?       @relation(fields: [moduleId], references: [id])
  lesson     Lesson?       @relation(fields: [lessonId], references: [id])
  user       User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

enum Role {
  admin
  mentor
  member
}

enum ProgressStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
  FAILED    
}

enum ProjectStatus {
  pending
  approved
  rejected
}

enum LessonType {
  MATERIAL
  QUIZ
}

enum ContentBlockType {
  TEXT
  VIDEO
  IMAGE
  CODE
  CALLOUT
  RESOURCE
}
